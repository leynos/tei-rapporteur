<?xml version="1.0" encoding="UTF-8"?>
<grammar xmlns="http://relaxng.org/ns/structure/1.0"
         xmlns:xml="http://www.w3.org/XML/1998/namespace">
  <start>
    <ref name="TEI"/>
  </start>

  <define name="TEI">
    <element name="TEI" ns="http://www.tei-c.org/ns/1.0">
      <ref name="teiHeader"/>
      <optional>
        <ref name="standOff"/>
      </optional>
      <ref name="text"/>
    </element>
  </define>

  <define name="teiHeader">
    <element name="teiHeader" ns="http://www.tei-c.org/ns/1.0">
      <ref name="fileDesc"/>
      <optional>
        <ref name="profileDesc"/>
      </optional>
      <optional>
        <ref name="encodingDesc"/>
      </optional>
      <optional>
        <ref name="revisionDesc"/>
      </optional>
    </element>
  </define>

  <define name="fileDesc">
    <element name="fileDesc" ns="http://www.tei-c.org/ns/1.0">
      <ref name="title"/>
      <optional>
        <ref name="series"/>
      </optional>
      <optional>
        <ref name="synopsis"/>
      </optional>
    </element>
  </define>

  <define name="title">
    <element name="title" ns="http://www.tei-c.org/ns/1.0">
      <text/>
    </element>
  </define>

  <define name="series">
    <element name="series" ns="http://www.tei-c.org/ns/1.0">
      <text/>
    </element>
  </define>

  <define name="synopsis">
    <element name="synopsis" ns="http://www.tei-c.org/ns/1.0">
      <text/>
    </element>
  </define>

  <define name="profileDesc">
    <element name="profileDesc" ns="http://www.tei-c.org/ns/1.0">
      <optional>
        <ref name="synopsis"/>
      </optional>
      <zeroOrMore>
        <ref name="speaker"/>
      </zeroOrMore>
      <zeroOrMore>
        <ref name="lang"/>
      </zeroOrMore>
    </element>
  </define>

  <define name="speaker">
    <element name="speaker" ns="http://www.tei-c.org/ns/1.0">
      <text/>
    </element>
  </define>

  <define name="lang">
    <element name="lang" ns="http://www.tei-c.org/ns/1.0">
      <text/>
    </element>
  </define>

  <define name="encodingDesc">
    <element name="encodingDesc" ns="http://www.tei-c.org/ns/1.0">
      <zeroOrMore>
        <ref name="annotationSystem"/>
      </zeroOrMore>
      <optional>
        <ref name="refsDecl"/>
      </optional>
    </element>
  </define>

  <define name="annotationSystem">
    <element name="annotationSystem" ns="http://www.tei-c.org/ns/1.0">
      <attribute name="xml:id" ns="http://www.w3.org/XML/1998/namespace">
        <text/>
      </attribute>
      <optional>
        <ref name="desc"/>
      </optional>
    </element>
  </define>

  <define name="refsDecl">
    <element name="refsDecl" ns="http://www.tei-c.org/ns/1.0">
      <zeroOrMore>
        <ref name="citeStructure"/>
      </zeroOrMore>
    </element>
  </define>

  <define name="citeStructure">
    <element name="citeStructure" ns="http://www.tei-c.org/ns/1.0">
      <optional>
        <attribute name="unit">
          <text/>
        </attribute>
      </optional>
      <attribute name="match">
        <text/>
      </attribute>
      <optional>
        <attribute name="use">
          <text/>
        </attribute>
      </optional>
      <optional>
        <attribute name="delim">
          <text/>
        </attribute>
      </optional>
      <zeroOrMore>
        <choice>
          <ref name="citeData"/>
          <ref name="citeStructure"/>
        </choice>
      </zeroOrMore>
    </element>
  </define>

  <define name="citeData">
    <element name="citeData" ns="http://www.tei-c.org/ns/1.0">
      <attribute name="property">
        <text/>
      </attribute>
      <optional>
        <attribute name="use">
          <text/>
        </attribute>
      </optional>
      <empty/>
    </element>
  </define>

  <define name="desc">
    <element name="desc" ns="http://www.tei-c.org/ns/1.0">
      <text/>
    </element>
  </define>

  <define name="revisionDesc">
    <element name="revisionDesc" ns="http://www.tei-c.org/ns/1.0">
      <zeroOrMore>
        <ref name="change"/>
      </zeroOrMore>
    </element>
  </define>

  <define name="change">
    <element name="change" ns="http://www.tei-c.org/ns/1.0">
      <oneOrMore>
        <choice>
          <text/>
          <ref name="respElement"/>
        </choice>
      </oneOrMore>
    </element>
  </define>

  <define name="respElement">
    <element name="resp" ns="http://www.tei-c.org/ns/1.0">
      <text/>
    </element>
  </define>

  <define name="standOff">
    <element name="standOff" ns="http://www.tei-c.org/ns/1.0">
      <zeroOrMore>
        <ref name="spanGrp"/>
      </zeroOrMore>
    </element>
  </define>

  <define name="spanGrp">
    <element name="spanGrp" ns="http://www.tei-c.org/ns/1.0">
      <optional>
        <attribute name="xml:id" ns="http://www.w3.org/XML/1998/namespace">
          <text/>
        </attribute>
      </optional>
      <attribute name="type">
        <text/>
      </attribute>
      <optional>
        <attribute name="resp">
          <text/>
        </attribute>
      </optional>
      <optional>
        <attribute name="corresp">
          <text/>
        </attribute>
      </optional>
      <optional>
        <attribute name="ana">
          <text/>
        </attribute>
      </optional>
      <zeroOrMore>
        <ref name="span"/>
      </zeroOrMore>
    </element>
  </define>

  <define name="span">
    <element name="span" ns="http://www.tei-c.org/ns/1.0">
      <optional>
        <attribute name="xml:id" ns="http://www.w3.org/XML/1998/namespace">
          <text/>
        </attribute>
      </optional>
      <optional>
        <attribute name="target">
          <text/>
        </attribute>
      </optional>
      <optional>
        <attribute name="from">
          <text/>
        </attribute>
      </optional>
      <optional>
        <attribute name="to">
          <text/>
        </attribute>
      </optional>
      <optional>
        <attribute name="source">
          <text/>
        </attribute>
      </optional>
      <optional>
        <attribute name="resp">
          <text/>
        </attribute>
      </optional>
      <optional>
        <attribute name="cert">
          <text/>
        </attribute>
      </optional>
      <optional>
        <attribute name="corresp">
          <text/>
        </attribute>
      </optional>
      <optional>
        <attribute name="ana">
          <text/>
        </attribute>
      </optional>
      <empty/>
    </element>
  </define>

  <define name="text">
    <element name="text" ns="http://www.tei-c.org/ns/1.0">
      <ref name="body"/>
    </element>
  </define>

  <define name="body">
    <element name="body" ns="http://www.tei-c.org/ns/1.0">
      <zeroOrMore>
        <choice>
          <ref name="p"/>
          <ref name="u"/>
          <ref name="div"/>
        </choice>
      </zeroOrMore>
    </element>
  </define>

  <define name="div">
    <element name="div" ns="http://www.tei-c.org/ns/1.0">
      <optional>
        <attribute name="xml:id" ns="http://www.w3.org/XML/1998/namespace">
          <text/>
        </attribute>
      </optional>
      <attribute name="type">
        <text/>
      </attribute>
      <zeroOrMore>
        <choice>
          <ref name="p"/>
          <ref name="u"/>
          <ref name="list"/>
        </choice>
      </zeroOrMore>
    </element>
  </define>

  <define name="list">
    <element name="list" ns="http://www.tei-c.org/ns/1.0">
      <optional>
        <attribute name="xml:id" ns="http://www.w3.org/XML/1998/namespace">
          <text/>
        </attribute>
      </optional>
      <zeroOrMore>
        <ref name="item"/>
      </zeroOrMore>
    </element>
  </define>

  <define name="item">
    <element name="item" ns="http://www.tei-c.org/ns/1.0">
      <optional>
        <attribute name="xml:id" ns="http://www.w3.org/XML/1998/namespace">
          <text/>
        </attribute>
      </optional>
      <optional>
        <attribute name="n">
          <text/>
        </attribute>
      </optional>
      <optional>
        <attribute name="corresp">
          <text/>
        </attribute>
      </optional>
      <optional>
        <ref name="label"/>
      </optional>
      <ref name="inlineContent"/>
    </element>
  </define>

  <define name="label">
    <element name="label" ns="http://www.tei-c.org/ns/1.0">
      <ref name="inlineContent"/>
    </element>
  </define>

  <define name="p">
    <element name="p" ns="http://www.tei-c.org/ns/1.0">
      <optional>
        <attribute name="xml:id" ns="http://www.w3.org/XML/1998/namespace">
          <text/>
        </attribute>
      </optional>
      <ref name="inlineContent"/>
    </element>
  </define>

  <define name="u">
    <element name="u" ns="http://www.tei-c.org/ns/1.0">
      <optional>
        <attribute name="xml:id" ns="http://www.w3.org/XML/1998/namespace">
          <text/>
        </attribute>
      </optional>
      <optional>
        <attribute name="n">
          <text/>
        </attribute>
      </optional>
      <optional>
        <attribute name="who">
          <text/>
        </attribute>
      </optional>
      <optional>
        <attribute name="source">
          <text/>
        </attribute>
      </optional>
      <optional>
        <attribute name="resp">
          <text/>
        </attribute>
      </optional>
      <optional>
        <attribute name="cert">
          <text/>
        </attribute>
      </optional>
      <optional>
        <attribute name="corresp">
          <text/>
        </attribute>
      </optional>
      <optional>
        <attribute name="ana">
          <text/>
        </attribute>
      </optional>
      <ref name="inlineContent"/>
    </element>
  </define>

  <define name="hi">
    <element name="hi" ns="http://www.tei-c.org/ns/1.0">
      <optional>
        <attribute name="rend">
          <text/>
        </attribute>
      </optional>
      <ref name="inlineContent"/>
    </element>
  </define>

  <define name="pause">
    <element name="pause" ns="http://www.tei-c.org/ns/1.0">
      <optional>
        <attribute name="dur">
          <text/>
        </attribute>
      </optional>
      <optional>
        <attribute name="type">
          <text/>
        </attribute>
      </optional>
      <empty/>
    </element>
  </define>

  <define name="inlineContent">
    <oneOrMore>
      <choice>
        <text/>
        <ref name="hi"/>
        <ref name="pause"/>
      </choice>
    </oneOrMore>
  </define>
</grammar>
