<?xml version="1.0" encoding="UTF-8"?>
<grammar xmlns="http://relaxng.org/ns/structure/1.0"
         xmlns:xml="http://www.w3.org/XML/1998/namespace">
  <start>
    <ref name="TEI"/>
  </start>

  <define name="TEI">
    <element name="TEI">
      <ref name="teiHeader"/>
      <ref name="text"/>
    </element>
  </define>

  <define name="teiHeader">
    <element name="teiHeader">
      <ref name="fileDesc"/>
      <optional>
        <ref name="profileDesc"/>
      </optional>
      <optional>
        <ref name="encodingDesc"/>
      </optional>
      <optional>
        <ref name="revisionDesc"/>
      </optional>
    </element>
  </define>

  <define name="fileDesc">
    <element name="fileDesc">
      <ref name="title"/>
      <optional>
        <ref name="series"/>
      </optional>
      <optional>
        <ref name="synopsis"/>
      </optional>
    </element>
  </define>

  <define name="title">
    <element name="title">
      <text/>
    </element>
  </define>

  <define name="series">
    <element name="series">
      <text/>
    </element>
  </define>

  <define name="synopsis">
    <element name="synopsis">
      <text/>
    </element>
  </define>

  <define name="profileDesc">
    <element name="profileDesc">
      <optional>
        <ref name="synopsis"/>
      </optional>
      <zeroOrMore>
        <ref name="speaker"/>
      </zeroOrMore>
      <zeroOrMore>
        <ref name="lang"/>
      </zeroOrMore>
    </element>
  </define>

  <define name="speaker">
    <element name="speaker">
      <text/>
    </element>
  </define>

  <define name="lang">
    <element name="lang">
      <text/>
    </element>
  </define>

  <define name="encodingDesc">
    <element name="encodingDesc">
      <zeroOrMore>
        <ref name="annotationSystem"/>
      </zeroOrMore>
    </element>
  </define>

  <define name="annotationSystem">
    <element name="annotationSystem">
      <attribute name="xml:id" ns="http://www.w3.org/XML/1998/namespace">
        <text/>
      </attribute>
      <optional>
        <ref name="desc"/>
      </optional>
    </element>
  </define>

  <define name="desc">
    <element name="desc">
      <text/>
    </element>
  </define>

  <define name="revisionDesc">
    <element name="revisionDesc">
      <zeroOrMore>
        <ref name="change"/>
      </zeroOrMore>
    </element>
  </define>

  <define name="change">
    <element name="change">
      <oneOrMore>
        <choice>
          <text/>
          <ref name="resp"/>
        </choice>
      </oneOrMore>
    </element>
  </define>

  <define name="resp">
    <element name="resp">
      <text/>
    </element>
  </define>

  <define name="text">
    <element name="text">
      <ref name="body"/>
    </element>
  </define>

  <define name="body">
    <element name="body">
      <zeroOrMore>
        <choice>
          <ref name="p"/>
          <ref name="u"/>
        </choice>
      </zeroOrMore>
    </element>
  </define>

  <define name="p">
    <element name="p">
      <optional>
        <attribute name="xml:id" ns="http://www.w3.org/XML/1998/namespace">
          <text/>
        </attribute>
      </optional>
      <ref name="inlineContent"/>
    </element>
  </define>

  <define name="u">
    <element name="u">
      <optional>
        <attribute name="xml:id" ns="http://www.w3.org/XML/1998/namespace">
          <text/>
        </attribute>
      </optional>
      <optional>
        <attribute name="who">
          <text/>
        </attribute>
      </optional>
      <ref name="inlineContent"/>
    </element>
  </define>

  <define name="hi">
    <element name="hi">
      <optional>
        <ref name="rend"/>
      </optional>
      <ref name="inlineContent"/>
    </element>
  </define>

  <define name="rend">
    <element name="rend">
      <text/>
    </element>
  </define>

  <define name="pause">
    <element name="pause">
      <optional>
        <attribute name="dur">
          <text/>
        </attribute>
      </optional>
      <optional>
        <attribute name="type">
          <text/>
        </attribute>
      </optional>
      <empty/>
    </element>
  </define>

  <define name="inlineContent">
    <oneOrMore>
      <choice>
        <text/>
        <ref name="hi"/>
        <ref name="pause"/>
      </choice>
    </oneOrMore>
  </define>
</grammar>

