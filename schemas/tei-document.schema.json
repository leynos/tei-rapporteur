{
  "$id": "urn:tei-rapporteur:schema:tei-document:0.1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TEI",
  "description": "Root TEI document combining metadata and textual content.\n\n# Examples\n\n```\nuse tei_core::{TeiDocument, TeiError};\n\nlet document = TeiDocument::from_title_str(\"Night Vale Episode\")?;\nassert_eq!(document.title().as_str(), \"Night Vale Episode\");\n# Ok::<(), TeiError>(())\n```",
  "type": "object",
  "properties": {
    "standOff": {
      "anyOf": [
        {
          "$ref": "#/$defs/standOff"
        },
        {
          "type": "null"
        }
      ]
    },
    "teiHeader": {
      "$ref": "#/$defs/teiHeader"
    },
    "text": {
      "$ref": "#/$defs/text"
    }
  },
  "required": [
    "teiHeader",
    "text"
  ],
  "$defs": {
    "AnnotationSystem": {
      "description": "Annotation toolkit metadata.",
      "type": "object",
      "properties": {
        "@xml:id": {
          "$ref": "#/$defs/AnnotationSystemId"
        },
        "desc": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "@xml:id"
      ]
    },
    "AnnotationSystemId": {
      "description": "Canonical identifier for an annotation system.",
      "type": "string"
    },
    "BodyBlock": {
      "description": "Block-level body content.",
      "oneOf": [
        {
          "description": "A prose paragraph.",
          "type": "object",
          "properties": {
            "p": {
              "$ref": "#/$defs/p"
            }
          },
          "additionalProperties": false,
          "required": [
            "p"
          ]
        },
        {
          "description": "A spoken utterance.",
          "type": "object",
          "properties": {
            "u": {
              "$ref": "#/$defs/u"
            }
          },
          "additionalProperties": false,
          "required": [
            "u"
          ]
        },
        {
          "description": "A thematic division grouping related content.",
          "type": "object",
          "properties": {
            "div": {
              "$ref": "#/$defs/div"
            }
          },
          "additionalProperties": false,
          "required": [
            "div"
          ]
        }
      ]
    },
    "Certainty": {
      "description": "Validated wrapper for TEI certainty values.",
      "type": "string"
    },
    "DivContent": {
      "description": "Content permitted inside a `<div>` element.",
      "oneOf": [
        {
          "description": "Paragraph block.",
          "type": "object",
          "properties": {
            "p": {
              "$ref": "#/$defs/p"
            }
          },
          "additionalProperties": false,
          "required": [
            "p"
          ]
        },
        {
          "description": "Utterance block.",
          "type": "object",
          "properties": {
            "u": {
              "$ref": "#/$defs/u"
            }
          },
          "additionalProperties": false,
          "required": [
            "u"
          ]
        },
        {
          "description": "List block.",
          "type": "object",
          "properties": {
            "list": {
              "$ref": "#/$defs/list"
            }
          },
          "additionalProperties": false,
          "required": [
            "list"
          ]
        }
      ]
    },
    "DocumentTitle": {
      "description": "Title metadata carried by a [`crate::TeiDocument`].\n\nTitles are trimmed and must not be empty, ensuring downstream consumers can\nalways serialize a non-empty `<title>` element.\n\n# Examples\n\n```\nuse tei_core::{DocumentTitle, DocumentTitleError};\n\nlet title = DocumentTitle::new(\"Voynich Manuscript\")?;\nassert_eq!(title.as_str(), \"Voynich Manuscript\");\n# Ok::<(), DocumentTitleError>(())\n```",
      "type": "string"
    },
    "Inline": {
      "description": "Inline content occurring inside paragraphs and utterances.\n\n# Examples\n\n```\nuse tei_core::{Hi, Inline, P};\n\nlet emphasis = Inline::Hi(Hi::new([Inline::text(\"important\")]));\nlet paragraph = match P::from_inline([Inline::text(\"An \"), emphasis]) {\n    Ok(paragraph) => paragraph,\n    Err(error) => panic!(\"paragraph should be valid: {error}\"),\n};\n\nassert_eq!(paragraph.content().len(), 2);\n```",
      "anyOf": [
        {
          "description": "Plain text content.",
          "type": "string"
        },
        {
          "description": "Emphasised content wrapped in `<hi>`.",
          "$ref": "#/$defs/hi"
        },
        {
          "description": "A pause marker rendered as `<pause/>`.",
          "$ref": "#/$defs/pause"
        }
      ]
    },
    "LanguageTag": {
      "description": "Validated language identifier stored within [`ProfileDesc`].",
      "type": "string"
    },
    "ResponsibleParty": {
      "description": "Named agent responsible for a revision note.",
      "type": "string"
    },
    "RevisionChange": {
      "description": "Individual revision note captured in `<revisionDesc>`.",
      "type": "object",
      "properties": {
        "$value": {
          "type": "string"
        },
        "resp": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResponsibleParty"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "$value"
      ]
    },
    "Speaker": {
      "description": "Validated wrapper for utterance speaker references.",
      "type": "string"
    },
    "SpeakerName": {
      "description": "Validated speaker name stored within [`ProfileDesc`].",
      "type": "string"
    },
    "XmlId": {
      "description": "Validated wrapper for TEI `xml:id` attributes.",
      "type": "string"
    },
    "body": {
      "description": "Ordered collection of block-level TEI elements.",
      "type": "object",
      "properties": {
        "$value": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/BodyBlock"
          }
        }
      }
    },
    "citeData": {
      "description": "Property extraction entry nested inside a citation structure.",
      "type": "object",
      "properties": {
        "@property": {
          "type": "string",
          "minLength": 1
        },
        "@use": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "@property"
      ]
    },
    "citeStructure": {
      "description": "Nested canonical citation structure.",
      "type": "object",
      "properties": {
        "@delim": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "@match": {
          "type": "string",
          "minLength": 1
        },
        "@unit": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "@use": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "citeData": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citeData"
          }
        },
        "citeStructure": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citeStructure"
          },
          "minItems": 1
        }
      },
      "required": [
        "@match"
      ]
    },
    "div": {
      "description": "Thematic or structural division of body content.",
      "type": "object",
      "properties": {
        "$value": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/DivContent"
          }
        },
        "@type": {
          "type": "string"
        },
        "@xml:id": {
          "anyOf": [
            {
              "$ref": "#/$defs/XmlId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "@type"
      ]
    },
    "encodingDesc": {
      "description": "Aggregates encoding metadata such as annotation systems.",
      "type": "object",
      "properties": {
        "annotationSystem": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AnnotationSystem"
          }
        },
        "refsDecl": {
          "anyOf": [
            {
              "$ref": "#/$defs/refsDecl"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "fileDesc": {
      "description": "Bibliographic metadata describing the TEI file.",
      "type": "object",
      "properties": {
        "series": {
          "type": [
            "string",
            "null"
          ]
        },
        "synopsis": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "$ref": "#/$defs/DocumentTitle"
        }
      },
      "required": [
        "title"
      ]
    },
    "hi": {
      "description": "Emphasised inline element corresponding to `<hi>`.",
      "type": "object",
      "properties": {
        "$value": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Inline"
          }
        },
        "@rend": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "item": {
      "description": "Single list item, optionally prefixed by a label.",
      "type": "object",
      "properties": {
        "$value": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Inline"
          }
        },
        "@corresp": {
          "type": [
            "string",
            "null"
          ]
        },
        "@n": {
          "type": [
            "string",
            "null"
          ]
        },
        "@xml:id": {
          "anyOf": [
            {
              "$ref": "#/$defs/XmlId"
            },
            {
              "type": "null"
            }
          ]
        },
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/label"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "label": {
      "description": "Label prefix for a list item, containing inline content.",
      "type": "object",
      "properties": {
        "$value": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Inline"
          }
        }
      }
    },
    "list": {
      "description": "Ordered or unordered list of items.",
      "type": "object",
      "properties": {
        "$value": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "@xml:id": {
          "anyOf": [
            {
              "$ref": "#/$defs/XmlId"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "p": {
      "description": "Paragraph element containing linear text segments.",
      "type": "object",
      "properties": {
        "$value": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Inline"
          }
        },
        "@xml:id": {
          "anyOf": [
            {
              "$ref": "#/$defs/XmlId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "pause": {
      "description": "Pause marker rendered as `<pause/>`.",
      "type": "object",
      "properties": {
        "@dur": {
          "type": [
            "string",
            "null"
          ]
        },
        "@type": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "profileDesc": {
      "description": "Audience and linguistic profile metadata.",
      "type": "object",
      "properties": {
        "lang": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LanguageTag"
          }
        },
        "speaker": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SpeakerName"
          }
        },
        "synopsis": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "refsDecl": {
      "description": "Citation declaration container.",
      "type": "object",
      "properties": {
        "citeStructure": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citeStructure"
          },
          "minItems": 1
        }
      },
      "minProperties": 1,
      "required": [
        "citeStructure"
      ]
    },
    "revisionDesc": {
      "description": "Revision history records.",
      "type": "object",
      "properties": {
        "change": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RevisionChange"
          }
        }
      }
    },
    "span": {
      "description": "Stand-off analytical span.",
      "type": "object",
      "properties": {
        "@ana": {
          "type": [
            "string",
            "null"
          ]
        },
        "@cert": {
          "anyOf": [
            {
              "$ref": "#/$defs/Certainty"
            },
            {
              "type": "null"
            }
          ]
        },
        "@corresp": {
          "type": [
            "string",
            "null"
          ]
        },
        "@from": {
          "type": [
            "string",
            "null"
          ]
        },
        "@resp": {
          "type": [
            "string",
            "null"
          ]
        },
        "@source": {
          "type": [
            "string",
            "null"
          ]
        },
        "@target": {
          "type": [
            "string",
            "null"
          ]
        },
        "@to": {
          "type": [
            "string",
            "null"
          ]
        },
        "@xml:id": {
          "anyOf": [
            {
              "$ref": "#/$defs/XmlId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "@to"
            ]
          },
          "then": {
            "properties": {
              "@from": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "@from"
            ]
          }
        }
      ],
      "anyOf": [
        {
          "properties": {
            "@target": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "@target"
          ]
        },
        {
          "properties": {
            "@from": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "@from"
          ]
        }
      ]
    },
    "spanGrp": {
      "description": "A logical grouping of analytical spans.",
      "type": "object",
      "properties": {
        "@ana": {
          "type": [
            "string",
            "null"
          ]
        },
        "@corresp": {
          "type": [
            "string",
            "null"
          ]
        },
        "@resp": {
          "type": [
            "string",
            "null"
          ]
        },
        "@type": {
          "type": "string",
          "pattern": "\\S"
        },
        "@xml:id": {
          "anyOf": [
            {
              "$ref": "#/$defs/XmlId"
            },
            {
              "type": "null"
            }
          ]
        },
        "span": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/span"
          }
        }
      },
      "required": [
        "@type"
      ]
    },
    "standOff": {
      "description": "Root TEI stand-off annotation container.",
      "type": "object",
      "properties": {
        "spanGrp": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/spanGrp"
          }
        }
      }
    },
    "teiHeader": {
      "description": "Metadata container for TEI header information.",
      "type": "object",
      "properties": {
        "encodingDesc": {
          "anyOf": [
            {
              "$ref": "#/$defs/encodingDesc"
            },
            {
              "type": "null"
            }
          ]
        },
        "fileDesc": {
          "$ref": "#/$defs/fileDesc"
        },
        "profileDesc": {
          "anyOf": [
            {
              "$ref": "#/$defs/profileDesc"
            },
            {
              "type": "null"
            }
          ]
        },
        "revisionDesc": {
          "anyOf": [
            {
              "$ref": "#/$defs/revisionDesc"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "fileDesc"
      ]
    },
    "text": {
      "description": "Body of a TEI document, including paragraphs and utterances.",
      "type": "object",
      "properties": {
        "body": {
          "$ref": "#/$defs/body"
        }
      },
      "required": [
        "body"
      ]
    },
    "u": {
      "description": "Spoken utterance that may reference a speaker and carry local provenance.",
      "type": "object",
      "properties": {
        "$value": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Inline"
          }
        },
        "@ana": {
          "type": [
            "string",
            "null"
          ]
        },
        "@cert": {
          "anyOf": [
            {
              "$ref": "#/$defs/Certainty"
            },
            {
              "type": "null"
            }
          ]
        },
        "@corresp": {
          "type": [
            "string",
            "null"
          ]
        },
        "@n": {
          "type": [
            "string",
            "null"
          ]
        },
        "@resp": {
          "type": [
            "string",
            "null"
          ]
        },
        "@source": {
          "type": [
            "string",
            "null"
          ]
        },
        "@who": {
          "anyOf": [
            {
              "$ref": "#/$defs/Speaker"
            },
            {
              "type": "null"
            }
          ]
        },
        "@xml:id": {
          "anyOf": [
            {
              "$ref": "#/$defs/XmlId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
